<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_inherit_activity" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.activity</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- Find the VAT field and add the new field after it -->
                <xpath expr="//field[@name='nrc']" position="before">
                    <field name="activity_conforme" string="Activité légale"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 
