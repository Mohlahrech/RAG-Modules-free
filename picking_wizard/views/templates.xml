<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_split_wizard_form" model="ir.ui.view">
            <field name="name">stock.picking.split.wizard.form</field>
            <field name="model">stock.picking.split.wizard</field>
            <field name="arch" type="xml">
                <form string="Allocate quantity Wizard">
                    <sheet>
                        <group>
                            <field name="line_ids">
                                <tree editable="bottom" create="false">  <!-- Disables creation -->
                                    <field name="product_id"/>
                                    <field name="product_uom_qty" string="Quantity to deliver"/>
                                    <field name="product_uom"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="move_id" invisible="1"/>
                                </tree>
                            </field>
                        </group>
                        <footer>
                            <button string="Set quantity" type="object" name="action_split" class="oe_highlight"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>


    <record id="view_stock_picking_split_wizard_tree" model="ir.ui.view">
        <field name="name">stock.picking.split.wizard.line.tree</field>
        <field name="model">stock.picking.split.wizard.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id"/>
                <field name="product_uom_qty" string="Quantity to deliver"/>
                <field name="product_uom"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
            </tree>
        </field>
    </record>
</odoo>